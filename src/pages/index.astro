---
/**
 * Forsiden. Én lang side med seks seksjoner i rekkefølgen i CLAUDE.md § 8.
 *
 * Hver seksjon åpner med figuren. Forklarende tekst ligger under, også i
 * DOM-rekkefølgen, slik at en skjermleser møter figuren først (P2).
 *
 * Tall i brødteksten finnes ikke som skrevne verdier. De hentes fra
 * data/processed/insights.json, og setningen bærer id-en til avledningen i
 * data-derivation (P3).
 *
 * S1 til S4 har innhold. De øvrige står med overskrift og en merknad om at de
 * ikke er laget ennå.
 */
import Side from "../layouts/Side.astro";
import Figur from "../komponenter/Figur.astro";
import Overskriftstall from "../komponenter/Overskriftstall.astro";
import { seksjoner } from "../lib/seksjoner";
import Kart from "../komponenter/Kart.astro";
import Rangering from "../komponenter/Rangering.astro";
import Sammenligning from "../komponenter/Sammenligning.astro";
import {
  overskriftstall,
  globaltBrentAreal,
  kartBrentAreal,
  rangering,
  sesongprofil,
  kumulativUke,
  kartEuropa,
  landsammenligning,
  rangeringEuropa,
} from "../figurer";
import { avledning, avledetTall } from "../lib/data";
import { tall, pverdi, desimaltall } from "../lib/format";

const figur1 = overskriftstall();
const figur2 = globaltBrentAreal();
const figur3 = kartBrentAreal();
const figur4 = rangering();
const figur5 = sesongprofil();
const figur6 = kumulativUke();
const figur7 = kartEuropa();
const figur8 = landsammenligning();
const figur9 = rangeringEuropa();

// Konsentrasjonen navngir de største landene. Det er en tillatt avledning
// (§ 7); en rangering av land mot hverandre er det ikke, og teksten sier
// derfor ingenting om hvem som ligger øverst i andelsvisningen.
const konsentrasjon = figur4.konsentrasjon;
const storste = (konsentrasjon.entities as { entity_name: string }[])
  .slice(0, 3)
  .map((e) => e.entity_name);

// Nivåforskjellen vises i det siste året alle tre seriene dekker, ikke som et
// gjennomsnitt. Et årsgjennomsnitt er ikke en tillatt avledning (§ 7), og et
// felles år er dessuten en sammenligning leseren kan etterprøve i figuren.
const NIVAA_AAR = 2018;
const nivaa = [
  { navn: "FireCCILT11", id: `rank.firecci_lt11_annual_burned_area.WLD.${NIVAA_AAR}` },
  { navn: "GFED5", id: `rank.gfed5_annual_burned_area.WLD.${NIVAA_AAR}` },
  { navn: "Our World in Data", id: `rank.owid_annual_area_burnt.WLD.${NIVAA_AAR}` },
].map((s) => ({ ...s, verdi: avledetTall(s.id, "value") }));

const dekningK8 = avledning("coverage.firecci_lt11_annual_burned_area.WLD");
const dekningK9 = avledning("coverage.gfed5_annual_burned_area.WLD");
const dekningK1 = avledning("coverage.owid_annual_area_burnt.WLD");

const trendK8 = avledning("trend.firecci_lt11_annual_burned_area.WLD");
const trendK9 = avledning("trend.gfed5_annual_burned_area.WLD");
const trendK1 = avledning("trend.owid_annual_area_burnt.WLD");

const manglerK8 = (dekningK8.missing_years as number[]).join(", ");
const aarFoer =
  (dekningK9.first_year as number) - (dekningK8.first_year as number);
const aarEtter =
  (dekningK9.last_year as number) - (dekningK8.last_year as number);

const [s1, s2, s3, s4, ...resten] = seksjoner;
---

<Side
  tittel="Skogbranner"
  ingress="Et oppslagsverk over hva målingene av skogbrann sier, hvor langt tilbake de går, og hvor de er usikre."
>
  <section class="seksjon" id={s1!.id} aria-labelledby={`${s1!.id}-tittel`}>
    <h2 id={`${s1!.id}-tittel`}>
      <span class="seksjon-kode">{s1!.kode}</span>
      {s1!.tittel}
    </h2>

    <Overskriftstall {...figur1} />

    <Figur {...figur2} />

    <div class="seksjon-tekst">
      <h3>Hva figuren viser</h3>
      <p>
        <strong>Brent areal</strong> er hvor stort område som har brent, målt i
        kvadratkilometer. Det sier hvor mye som brant, ikke hvor mange branner
        det var. Én stor brann og mange små kan gi samme areal.
      </p>
      <p>
        Figuren viser tre serier, ikke én kurve. Hver serie er ett
        satellittprodukt, og hvert produkt dekker sin egen periode: FireCCILT11
        fra <span data-derivation="coverage.firecci_lt11_annual_burned_area.WLD"
          >{dekningK8.first_year} til {dekningK8.last_year}</span
        >, GFED5 fra <span data-derivation="coverage.gfed5_annual_burned_area.WLD"
          >{dekningK9.first_year} til {dekningK9.last_year}</span
        >, og Our World in Data fra <span
          data-derivation="coverage.owid_annual_area_burnt.WLD"
          >{dekningK1.first_year}</span
        >. De er tegnet hver for seg, med brudd mellom seg, fordi de ikke er den
        samme målingen.
      </p>
      <p>
        Den blekere linjen er FireCCILT11. Produsenten har selv merket
        datasettet som foreløpig, og linjen er tegnet svakere for at det skal
        synes. Det er produsentens merking, ikke vår vurdering av kvaliteten.
        Hver serie har i tillegg sin egen punktform, slik at de kan skilles uten
        farge.
      </p>
      <p data-derivation="coverage.firecci_lt11_annual_burned_area.WLD">
        {manglerK8} mangler helt i FireCCILT11. Året er tegnet som et brudd i
        linjen — ikke som null, og ikke som en verdi vi har regnet oss fram til.
      </p>

      <h3>Hvorfor de ligger på ulikt nivå</h3>
      <p>
        {NIVAA_AAR} er det siste året alle tre dekker. Der viser{" "}
        {
          nivaa.map((s, i) => (
            <>
              {i > 0 ? (i === nivaa.length - 1 ? " og " : ", ") : ""}
              {s.navn}{" "}
              <span data-derivation={s.id}>{tall(s.verdi)} km²</span>
            </>
          ))
        }.
      </p>
      <p>
        Forskjellen handler om hva produktene ser. En <strong
          >satellittsensor</strong
        > er et måleinstrument om bord som registrerer stråling fra bakken, og
        brannspor kjennes igjen på at overflaten endrer farge og varme. Hvor
        liten en brann kan være før den forsvinner mellom målepunktene, avhenger
        av oppløsningen, av hvor ofte satellitten passerer, og av skydekket.
        GFED5 tar i tillegg med brent areal i jordbruksland, torvmark og
        avskogingsområder som de andre produktene i liten grad fanger opp.
      </p>
      <p>
        Avstanden mellom to serier er derfor informasjon om målingene, ikke om
        verden. Den kan ikke leses som en endring.
      </p>

      <h3>Hvorfor to av dem peker i hver sin retning</h3>
      <p>
        For to av seriene er det regnet ut en trend. En <strong>trend</strong> er
        den jevne endringen gjennom perioden, regnet med en metode som tåler
        enkeltår som stikker ut. Beregningen gir også en <strong>p-verdi</strong
        >: et mål på hvor godt tilfeldig variasjon alene forklarer mønsteret.
        Lav p-verdi betyr at tilfeldighet er en dårlig forklaring.
      </p>
      <p>
        FireCCILT11 stiger med <span
          data-derivation="trend.firecci_lt11_annual_burned_area.WLD"
          >{tall(Math.abs(trendK8.slope_per_decade as number))} km² per tiår fra{
            " "
          }{trendK8.first_year} til {trendK8.last_year} ({pverdi(trendK8.p_value as number)})</span
        >. GFED5 faller med <span
          data-derivation="trend.gfed5_annual_burned_area.WLD"
          >{tall(Math.abs(trendK9.slope_per_decade as number))} km² per tiår fra{
            " "
          }{trendK9.first_year} til {trendK9.last_year} ({pverdi(trendK9.p_value as number)})</span
        >.
      </p>
      <p>
        Retningene gjelder hver sin periode, og de motsier derfor ikke
        hverandre. FireCCILT11 begynner <span
          data-derivation="coverage.firecci_lt11_annual_burned_area.WLD"
          >{aarFoer} år før</span
        > GFED5 og slutter <span
          data-derivation="coverage.gfed5_annual_burned_area.WLD"
          >{aarEtter} år før</span
        > den. En serie som ender der FireCCILT11 ender, sier ingenting om årene
        etter, og en som begynner der GFED5 begynner, sier ingenting om årene før.
      </p>
      <p>
        Perioden er den ene grunnen. Den andre er at trendene er regnet på hvert
        sitt produkt, og produktene ser ulikt mye — det samme som gjør at de
        ligger på ulikt nivå. En endring i det ett produkt fanger opp, er ikke
        uten videre den samme endringen et annet produkt ville målt over de
        samme årene. To trender fra to produkter over to perioder er to
        observasjoner, ikke to svar på samme spørsmål.
      </p>
      <p>
        Av samme grunn er seriene ikke skjøtt sammen til én lang linje. En slik
        linje ville hatt et sprang der det ene produktet tar over for det andre,
        og et sprang som kommer av byttet, ser ut som en endring i verden uten å
        være det.
      </p>
      <p data-derivation="trend.owid_annual_area_burnt.WLD">
        For Our World in Datas serie er det ikke regnet noen trend. Serien
        dekker {trendK1.n_years} hele år, og grensen for en trend på verdensnivå
        er {trendK1.min_years}. Under den veier enkeltår for tungt: tas det
        siste året med eller ikke, endrer både størrelsen på endringen og hvor
        sikker beregningen ser ut.
      </p>

      <h3>Hva figuren ikke svarer på</h3>
      <p>
        Figuren sier ikke hvilken serie som ligger nærmest sannheten. Det er en
        vurdering av produktene som denne siden ikke gjør. Den viser hva hver av
        dem måler, hvor langt tilbake de går, og hvor de er usikre.
      </p>
      <p>
        Det siste året i figuren er ikke omme. Det er tegnet med åpent merke og
        stiplet strek, og viser bare det som er registrert så langt.
      </p>
    </div>
  </section>

  <section class="seksjon" id={s2!.id} aria-labelledby={`${s2!.id}-tittel`}>
    <h2 id={`${s2!.id}-tittel`}>
      <span class="seksjon-kode">{s2!.kode}</span>
      {s2!.tittel}
    </h2>

    <Kart {...figur3} />

    <Rangering {...figur4} />

    <div class="seksjon-tekst">
      <h3>Hva kartet viser</h3>
      <p>
        Kartet viser hvor mye som brant i hvert land i {figur3.aar}, det siste
        hele året i serien. Fargen står for verdien i den visningen bryteren
        står på — jo sterkere farge, jo høyere verdi.
      </p>
      <p>
        Land uten data er tegnet uten farge og står som «ingen data» i
        tabellen. Det er ikke det samme som at ingenting brant: kilden fører
        ikke alle land hvert år, og et land uten rad er et land vi ikke har et
        tall for.
      </p>
      <p>
        Noen land står med null. Den nullen betyr at satellittene ikke har
        påvist brent areal, og kilden skiller ikke mellom «ingenting brant»,
        «brannene var for små til å bli sett» og «området ble ikke observert».
        Forbeholdet står nummerert under figuren.
      </p>

      <h3>To måter å måle på</h3>
      <p>Bryteren over kartet velger hva fargen står for.</p>
      <p>
        <strong>Brent areal i kvadratkilometer</strong> viser hvor store
        områder som brant. Store land kommer høyt opp fordi de er store — et
        land med mye areal har mer som kan brenne.
      </p>
      <p>
        <strong>Andel av landarealet</strong> deler det brente arealet på
        landets samlede landareal. Da blir små og store land sammenlignbare, og
        tallet svarer på hvor stor del av landet som brant, ikke hvor mange
        kvadratkilometer det ble.
      </p>
      <p>
        De to svarer på hvert sitt spørsmål, og rekkefølgen mellom landene er
        ikke den samme i de to visningene. Ingen av dem er den riktige; det
        avhenger av hva du vil vite.
      </p>
      <p>
        Nevneren i andelen er landarealet regnet fra det samme kartgrunnlaget
        kartet er tegnet med, slik at flaten du ser og tallet du leser hører
        sammen.
      </p>

      <h3>Hvor mye som ligger hos de største</h3>
      <p data-derivation={`concentration.owid_annual_area_burnt.${figur4.aar}`}>
        De {konsentrasjon.top_n} landene med størst brent areal i {figur4.aar}
        {" "}stod for {desimaltall(konsentrasjon.share_pct as number)} prosent av
        verdens totale brente areal. De tre største var {storste[0]}, {storste[1]}
        {" "}og {storste[2]}.
      </p>
      <p>
        Tallet beskriver fordelingen mellom land. Hvorfor arealet ligger der det
        ligger, sier siden ingenting om.
      </p>

      <h3>Hva kartet ikke viser</h3>
      <p data-derivation="trend.owid_annual_area_burnt.WLD">
        Kartet viser ingen trend. En trend for verden eller en verdensdel
        krever en lengre serie enn denne kilden har: serien dekker {
          trendK1.n_years
        } hele år, og grensen for et aggregat er {trendK1.min_years}.
        Kontinenter og regioner kan derfor vises som verdier for ett år, men
        ikke som en retning over tid.
      </p>
      <p>
        Kartet viser heller ikke hvor i landet det brant. Tallet er en sum for
        hele landet, og et land kan ha alt sitt brente areal i ett hjørne.
      </p>

      <h3>Tabellen</h3>
      <p>
        Tabellen viser hvert land med brent areal i kvadratkilometer, andel av
        landarealet og andel av verdens brente areal. Uten sortering står
        landene etter brent areal, med det største først.
      </p>
      <p>
        Land uten data står med «ingen data» og havner sist uansett hvilken vei
        du sorterer. En måling som mangler, er ikke en lav verdi.
      </p>
    </div>
  </section>

  <section class="seksjon" id={s3!.id} aria-labelledby={`${s3!.id}-tittel`}>
    <h2 id={`${s3!.id}-tittel`}>
      <span class="seksjon-kode">{s3!.kode}</span>
      {s3!.tittel}
    </h2>

    <Figur {...figur5} />

    <Figur {...figur6} />

    <div class="seksjon-tekst">
      <h3>Hva sesongfiguren viser</h3>
      <p>
        Hver rute er én verdensdel. Kurven viser hvor mye som brenner i hver
        uke av året: uke 1 sammenlignet med uke 1 i de andre årene, uke 2 med
        uke 2, og så videre.
      </p>
      <p>
        En <strong>brannsesong</strong> er den delen av året da det brenner
        mest et bestemt sted. Kurvene topper seg i ulike uker fra verdensdel
        til verdensdel — når på året det brenner, er ikke det samme overalt.
      </p>
      <p>
        <strong>Medianen</strong> er den midterste verdien når årene sorteres
        etter størrelse: halvparten av årene ligger over, halvparten under. Den
        brukes framfor gjennomsnittet fordi ett år som stikker ut, ikke skal
        flytte hele kurven.
      </p>

      <h3>Hvordan rutene skal leses</h3>
      <p>
        Hver rute har sin egen loddrette skala. Formen på kurven kan
        sammenlignes mellom verdensdeler — når toppen kommer, og hvor bred den
        er. Høyden kan ikke: en rute med lav akse viser ikke mindre brann enn
        naboruten, den viser en annen skala. Tallene står i tabellen under.
      </p>
      <p>
        Verdensdelene er summert av landene kilden fører i hver av dem. GWIS
        svarer ikke på verdensdel direkte, så inndelingen er kildens, mens
        summeringen er vår.
      </p>

      <h3>Hva den kumulative kurven viser</h3>
      <p>
        Kurven legger sammen ukene etter hvert som året går. Ved utgangen av
        uke 10 viser den alt som har brent i årets ti første uker. En kumulativ
        kurve synker aldri; det den forteller, er hvor bratt den stiger, og
        når.
      </p>
      <p>
        Den tykke linjen er inneværende år. Den er markert som ufullstendig og
        stopper der målingene stopper — ikke ved årsslutt.
      </p>

      <h3>Båndet bak kurven</h3>
      <p data-derivation={`season_band.gwis_weekly_burned_area.WLD`}>
        Båndet er et <strong>persentilbånd</strong>. For hver uke er de hele
        årene sortert etter størrelse, og båndet dekker området fra den {
          figur6.bandPct[0]
        }. til den {figur6.bandPct[1]}. persentilen: ett år av ti ligger over
        båndet, ett av ti under. Linjen inne i båndet er medianen.
      </p>
      <p data-derivation={`season_band.gwis_weekly_burned_area.WLD`}>
        {
          figur6.bandKanter.interpolert
            ? `Med ${figur6.grunnlagsaar.length} år hviler kantene av båndet på interpolasjon mellom to enkeltår: den nedre mellom ${figur6.bandKanter.nedre}, den øvre mellom ${figur6.bandKanter.ovre}.`
            : `Med ${figur6.grunnlagsaar.length} år faller kantene av båndet sammen med enkeltår: den nedre på ${figur6.bandKanter.nedre}, den øvre på ${figur6.bandKanter.ovre}.`
        } Båndet blir mer stabilt jo flere år serien får.
      </p>
      <p>
        Båndet sier hvor et vanlig år pleier å ligge på dette tidspunktet i
        året, og hvor mye årene pleier å sprike. Det sier ingenting om hvorfor
        et enkelt år ligger der det ligger.
      </p>
      <p data-derivation={`coverage.gwis_weekly_burned_area.WLD`}>
        Inneværende år er ikke med i grunnlaget for verken båndet eller
        medianen. Et år som ikke er omme, kan ikke være med på å definere hva
        et helt år pleier å være. Båndet er regnet over de {
          figur6.grunnlagsaar.length
        } hele årene serien dekker.
      </p>

      <h3>Hva figurene ikke svarer på</h3>
      <p>
        Uke 1 er ikke den samme datoen hvert år, og ukene forskyver seg med
        noen dager fra år til år. Kurvene svarer på når i sesongen noe skjedde,
        ikke på hvilken dato.
      </p>
    </div>
  </section>

  <section class="seksjon" id={s4!.id} aria-labelledby={`${s4!.id}-tittel`}>
    <h2 id={`${s4!.id}-tittel`}>
      <span class="seksjon-kode">{s4!.kode}</span>
      {s4!.tittel}
    </h2>

    <Kart
      {...figur7}
      utenGeometriGrunn="ligger utenfor kartutsnittet"
    />

    <Sammenligning {...figur8} />

    <Rangering {...figur9} />

    <div class="seksjon-tekst">
      <h3>Hva kartet viser</h3>
      <p>
        EFFIS kartlegger brent areal fra satellitt. Kartleggingen dekker
        Europa, Midtøsten og Nord-Afrika, og kartet viser hele det området —
        seksjonen heter Europa, men kilden stopper ikke ved Europas grense, og
        å klippe bort resten ville skjult hvor tallene kommer fra.
      </p>
      <p>
        Det siste året som er omme, er {figur7.aar}. Inneværende år er ikke med
        i kartet: et år som ikke er slutt, ville sett ut som et lavt år.
      </p>

      <h3>Hvordan de to visningene skiller seg</h3>
      <p>
        Den ene visningen er brent areal i kvadratkilometer. Den svarer på hvor
        mye som brant. Den andre er det samme arealet delt på landets samlede
        landareal, vist i prosent. Den svarer på hvor stor del av landet som
        brant. Fargen står for verdien i den visningen bryteren står på — jo
        sterkere farge, jo høyere verdi.
      </p>
      <p>
        De to gir ulik rekkefølge. Et stort land kan ha mye brent areal og
        likevel en liten andel; et lite land kan ha lite areal og en stor
        andel. Ingen av visningene er den riktige — de svarer på hvert sitt
        spørsmål.
      </p>
      <p>
        Landarealet i nevneren kommer fra Natural Earth, som også leverer
        flatene på kartet.
      </p>

      <h3>Hvordan sammenligningen brukes</h3>
      <p>
        Kryss av for inntil {figur8.maksValgte} land. De valgte landene tegnes
        med navn; de øvrige ligger blekt i bakgrunnen, slik at et land kan leses
        mot resten uten at de andre forsvinner.
      </p>
      <p>
        Uten JavaScript virker avkryssingen fortsatt, og tallene står i tabellen
        under.
      </p>
      <p>
        {figur8.maksValgte} land er krysset av på forhånd: de med størst brent
        areal i det siste året som er omme. Utvalget er maskinelt og sier
        ingenting om hvilke land som er interessante.
      </p>

      <h3>To serier fra samme kilde</h3>
      <p>
        EFFIS gir to sett tall for de samme landene, og de er ikke det samme.
      </p>
      <p>
        Den stiplede linjen er tallene landene selv rapporterer inn. Hvert land
        følger sine egne definisjoner av hva som telles som en skogbrann, og
        serien starter i {figur8.dekningPerKilde.K3!.fra} — men med bare noen
        få land. Flere kommer til utover i serien.
      </p>
      <p>
        Den heltrukne linjen er EFFIS' egen satellittkartlegging fra {
          figur8.dekningPerKilde.K4!.fra
        }. Den er ikke rapportert av noen, og den følger én definisjon for alle
        land.
      </p>
      <p>
        De to er tegnet hver for seg og skjøtes aldri sammen. Ligger de på ulikt
        nivå for samme land og år, er det fordi de måler ulikt — ikke fordi noe
        endret seg det året.
      </p>

      <h3>Hva figurene ikke svarer på</h3>
      <p>
        Trender er regnet hver for seg, innenfor én kilde og én kvalitet, og
        over hver sin periode. To serier for samme land kan derfor peke i hver
        sin retning uten at noen av dem er regnet feil. En trend på tvers av de
        to ville målt skiftet i metode.
      </p>
      <p>
        Tabellen viser rekkefølgen mellom landene i det siste hele året.
        Rekkefølgen er en sortering, ikke en avledning: siden rangerer år
        innenfor ett land, ikke land mot hverandre.
      </p>
    </div>
  </section>

  {
    resten.map((s) => (
      <section class="seksjon" id={s.id} aria-labelledby={`${s.id}-tittel`}>
        <h2 id={`${s.id}-tittel`}>
          <span class="seksjon-kode">{s.kode}</span>
          {s.tittel}
        </h2>
        <p class="ikke-laget">Denne seksjonen er ikke laget ennå.</p>
      </section>
    ))
  }
</Side>
