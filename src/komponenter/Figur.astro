---
/**
 * Gjenbrukbar figur: tittel, graf, kildelinje, fotnoter og tabellvisning.
 *
 * Kravene til hver figur står i CLAUDE.md § 9, kildelinjen i P5 og fotnotene
 * i P6. Komponenten bygger kildelinjen fra data/_sources.json og
 * fotnotetekstene fra data/_footnotes.json — ingen av delene skrives for hånd
 * i en side.
 *
 * En figur kan vise flere kilder. Da får hver kilde sin egen linje, med den
 * dekningsperioden akkurat den serien har i denne figuren, og med siteringen
 * kilden krever (§ 5).
 *
 * Rekkefølgen i DOM er figur før forklarende tekst (P2). Teksten som hører
 * til seksjonen legges etter komponenten, ikke inni den.
 */
import { kilde, fotnotetekst, kildestatus } from "../lib/data";
import { aarstallTekst, dato } from "../lib/format";

interface Tabell {
  beskrivelse: string;
  kolonner: string[];
  rader: (string | number)[][];
}

interface Tegnforklaring {
  /** Modifikator som styrer hvordan merket tegnes, se global.css. */
  merke: string;
  tekst: string;
}

interface Props {
  id: string;
  tittel: string;
  svg: string;
  /** Eget oppsett for smal skjerm, ikke den samme figuren skalert ned (§ 9). */
  svgMobil: string;
  grafBeskrivelse: string;
  kildeIder: string[];
  /** Dekningsperioden hver kilde har i denne figuren (P5). */
  dekningPerKilde: Record<string, { fra: number; til: number }>;
  /** Filnavnet på figurens egen CSV, skrevet av byggesteget (P5). */
  csvFil: string;
  fotnoter: string[];
  tabell: Tabell;
  tegnforklaring?: Tegnforklaring[];
}

const {
  id,
  tittel,
  svg,
  svgMobil,
  grafBeskrivelse,
  kildeIder,
  dekningPerKilde,
  csvFil,
  fotnoter,
  tabell,
  tegnforklaring = [],
} = Astro.props;

const base = import.meta.env.BASE_URL;

// Lenken skal peke til den CSV-filen figuren faktisk bruker — figurens egen,
// med nøyaktig de radene den tegner, ikke den kanoniske filen som også bærer
// andre serier (P5).
const csvUrl = `${base}data/figur/${csvFil}`;

const kildene = kildeIder.map((kildeId) => {
  const k = kilde(kildeId);
  const dekning = dekningPerKilde[kildeId];
  if (!dekning) {
    throw new Error(
      `Kilden ${kildeId} mangler dekningsperiode i figuren ${id}. Kildelinjen kan ikke bygges (P5).`,
    );
  }

  // Feilet siste henting, beholdt pipelinen forrige datasett. Da skal leseren
  // se en diskré merknad om at akkurat denne serien ikke er oppdatert siden
  // dato X (§ 4). Går alt bra, står det ingenting.
  const status = kildestatus(kildeId);
  const ikkeOppdatert =
    status && status.status !== "ok" && status.last_success
      ? dato(status.last_success)
      : null;

  return { kildeId, k, dekning, ikkeOppdatert };
});
---

<div class="figur" id={id}>
  <h3 class="figur-tittel">{tittel}</h3>

  {
    kildene
      .filter((rad) => rad.ikkeOppdatert)
      .map((rad) => (
        <p class="merknad-ikke-oppdatert">
          {rad.k.name} er ikke oppdatert siden {rad.ikkeOppdatert}. Siste
          henting fra kilden gikk ikke gjennom, og figuren viser forrige
          datasett.
        </p>
      ))
  }

  <figure class="figur-graf">
    <div class="graf graf--bred" role="img" aria-label={grafBeskrivelse} set:html={svg} />
    <div class="graf graf--smal" role="img" aria-label={grafBeskrivelse} set:html={svgMobil} />
  </figure>

  {
    tegnforklaring.length > 0 && (
      <ul class="tegnforklaring">
        {tegnforklaring.map((t) => (
          <li>
            <span class={`tegnforklaring-merke tegnforklaring-merke--${t.merke}`} aria-hidden="true" />
            {t.tekst}
          </li>
        ))}
      </ul>
    )
  }

  {
    kildene.map((rad) => (
      <p class="kildelinje">
        <span class="kildelinje-merke">Kilde</span>
        <a href={rad.k.url} rel="noreferrer">{rad.k.name}</a>.
        Dekning i denne figuren: {aarstallTekst(rad.dekning.fra)}–{aarstallTekst(rad.dekning.til)}.
        Data hentet {dato(rad.k.downloaded_at)}.
        Lisens: <a href={rad.k.license_url} rel="noreferrer">{rad.k.license}</a>.
      </p>
    ))
  }

  <p class="kildelinje">
    <span class="kildelinje-merke">Tallene</span>
    <a href={csvUrl} download>Last ned figurens tall som CSV ({csvFil})</a>. Filen
    inneholder nøyaktig de radene figuren tegner.
  </p>

  {
    kildene
      .filter((rad) => rad.k.attribution)
      .map((rad) => (
        <p class="kildelinje-sitering">
          <span class="kildelinje-merke">Sitering</span>
          <cite>{rad.k.attribution}</cite>
        </p>
      ))
  }

  {
    fotnoter.length > 0 && (
      <div class="fotnoter">
        <h4 class="fotnoter-tittel" id={`${id}-fotnoter`}>
          Forbehold for denne figuren
        </h4>
        <ol aria-labelledby={`${id}-fotnoter`}>
          {fotnoter.map((kode) => (
            <li id={`${id}-${kode}`}>{fotnotetekst(kode)}</li>
          ))}
        </ol>
      </div>
    )
  }

  <details class="tabell">
    <summary>Vis tallene som tabell</summary>
    <div class="tabell-ramme">
      <table>
        <caption>{tabell.beskrivelse}</caption>
        <thead>
          <tr>
            {tabell.kolonner.map((kolonne) => <th scope="col">{kolonne}</th>)}
          </tr>
        </thead>
        <tbody>
          {
            tabell.rader.map((rad) => (
              <tr>
                {rad.map((celle, i) =>
                  i === 0 ? (
                    <th scope="row">{celle}</th>
                  ) : (
                    <td>{celle}</td>
                  ),
                )}
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </details>
</div>
