---
/**
 * Sidemal: hode, hopp-til-innhold, innholdsnavigasjon og sidefot.
 *
 * Ingen ressurser hentes fra andre domener. Ingen webfonter, ingen sporing,
 * ingen samtykkebanner (CLAUDE.md T2).
 */
import Innholdsnavigasjon from "../komponenter/Innholdsnavigasjon.astro";
import Sidefot from "../komponenter/Sidefot.astro";
import "../styles/global.css";

interface Props {
  tittel: string;
  ingress: string;
}

const { tittel, ingress } = Astro.props;
---

<!doctype html>
<html lang="nb">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tittel}</title>
    <meta name="description" content={ingress} />
    <meta name="color-scheme" content="light dark" />
  </head>
  <body>
    <a class="hopp-til-innhold" href="#innhold">Hopp til innholdet</a>

    <header class="sidehode">
      <div class="innramming">
        <h1>{tittel}</h1>
        <p class="ingress">{ingress}</p>
      </div>
    </header>

    <div class="innramming sideoppsett">
      <Innholdsnavigasjon />
      <main id="innhold">
        <slot />
      </main>
    </div>

    <Sidefot />

<script is:inline>
  /*
   * Sortering av rangeringstabellene.
   *
   * Skriptet hører til src/komponenter/Rangering.astro, men står her fordi
   * siden har flere rangeringstabeller: lå det i komponenten, ville det blitt
   * sendt én gang per tabell. Hver tabell får sin egen sortering — knappene i
   * én tabell rører aldri en annen.
   *
   * Tabellen er ferdig sortert i HTML og fullt lesbar uten dette skriptet
   * (CLAUDE.md § 9). Knappene legges derfor til her, ikke i malen — uten
   * skript ville de vært knapper som ikke gjorde noe.
   *
   * Ingen avhengigheter, ingen forespørsler ut (T2).
   */
  for (const tabell of document.querySelectorAll("table[data-sorterbar]")) {
    const kropp = tabell.tBodies[0];
    const hoder = [...tabell.tHead.rows[0].cells];

    const verdi = (rad, i) => {
      const celle = rad.cells[i];
      if (hoder[i].dataset.type === "tall") {
        const raa = celle.dataset.verdi;
        // Tom betyr «ingen data». Den skal ligge sist uansett retning, så den
        // får en verdi som aldri kan vinne en sammenligning.
        return raa === "" || raa === undefined ? null : Number(raa);
      }
      return celle.textContent.trim();
    };

    const sorter = (i, synkende) => {
      const rader = [...kropp.rows];
      rader.sort((a, b) => {
        const x = verdi(a, i);
        const y = verdi(b, i);
        if (x === null && y === null) return 0;
        if (x === null) return 1;
        if (y === null) return -1;
        const c = typeof x === "number" ? x - y : x.localeCompare(y, "nb");
        return synkende ? -c : c;
      });
      for (const rad of rader) kropp.append(rad);
    };

    hoder.forEach((hode, i) => {
      const tekst = hode.textContent.trim();
      const knapp = document.createElement("button");
      knapp.type = "button";
      knapp.className = "sorteringsknapp";
      knapp.textContent = tekst;
      hode.textContent = "";
      hode.append(knapp);

      knapp.addEventListener("click", () => {
        const synkende = hode.getAttribute("aria-sort") !== "descending";
        for (const annen of hoder) annen.removeAttribute("aria-sort");
        hode.setAttribute("aria-sort", synkende ? "descending" : "ascending");
        sorter(i, synkende);
      });
    });
  }
</script>
  </body>
</html>
